<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\ViewModel\Magewire as MagewireViewModel;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var MagewireViewModel $magewireViewModel */

$magewireViewModel = $block->getData('view_model');
$magewireFragment = $magewireViewModel->utils()->fragment();

/** @internal Do not modify to ensure Magewire continues to function correctly. */
?>
<?php $script = $magewireFragment->make()->script()->start() ?>
<script>
    <?php /*
        Replace a BC-enabled component's `$wire` with a single backwards compatibility proxy.
        Both wire access paths read this exact object — Alpine's `wire` magic (`this.$wire.*`
        resolves to `component.$wire[prop]`) and `Magewire.find(id)` (which returns
        `components[id].$wire`) — so all BC wire concerns live in one proxy without nested
        re-wrapping. Handled members:

        - `sync`: @deprecated v1 `$wire.sync(name, value)` (set + immediate commit) has no v3
          equivalent and isn't covered by the proxy aliases, so it would fall through to a
          `callMethod: sync` request and fail with "Method not found: sync". Map it onto the native
          `$set` (which defaults `live = true`) — the same safe live commit path as
          `wire:model.live`. Migrate to `$wire.$set(name, value)` in v3-native code.
        - `__instance`: return a backwards-compatible component proxy instead of the raw component.
    */ ?>
    Magewire.hook('component.init', ({ component }) => {
        <?php /*
            Not gated on memo.bc.enabled: `sync` and `__instance` are universally safe ($set and a
            pass-through component proxy), and `__instance` was ungated in the original Magewire.find
            override this replaces. Gating here also misses components whose bc flag isn't resolved in
            a given render context (e.g. an address form re-rendered via a subsequent Magewire request),
            which is exactly when $wire.sync() would silently fall through to a "Method not found".
            This template only loads on checkout, so the wrap stays scoped to checkout components.
        */ ?>
        <?php /* Already wrapped — quick return so we never stack a proxy on a proxy. */ ?>
        if (component.__bcWire) {
            return;
        }

        component.$wire = component.__bcWire = new Proxy(component.$wire, {
            get(target, prop, receiver) {
                if (prop === 'sync') {
                    return (name, value, live = true) => target.$set(name, value, live);
                }

                if (prop === '__instance') {
                    return _magewireMakeComponentBackwardsCompatibleSync(target.__instance);
                }

                return Reflect.get(target, prop, receiver);
            }
        });
    });

    <?php /* @todo Should return `true/false` based on a Magewire system config settings. */ ?>
    const magewireIsComponentBackwardsCompatibilityEnabled = function(component) {
        return true;
    }

    <?php /* Internal sync proxy builder. Use only where a synchronous proxy is required (e.g. Magewire.find().__instance). */ ?>
    const _magewireMakeComponentBackwardsCompatibleSync = function(component) {
        const checksum = component.snapshot?.checksum;

        if (component.magewire?.bc?.checksum === checksum) {
            return component.magewire.bc.proxy;
        }

        const proxy = new Proxy(component, {
            get(target, prop, receiver) {
                <?php /* @deprecated 'component.call()' has been replaced with 'component.$wire.call()'. */ ?>
                if (prop === 'call') {
                    return (method, ...params) => target.$wire.call(method, ...params);
                }

                if ('bc' in target.effects) {
                    const value = target.effects.bc[prop] !== undefined
                        ? target.effects.bc[prop]
                        : target.effects.bc.map?.[prop];

                    if (value !== undefined) {
                        if (typeof value === 'string' && value.startsWith('path:')) {
                            return value.slice(5).split('.').reduce((obj, key) => obj?.[key], target);
                        }

                        return value;
                    }
                }

                return Reflect.get(target, prop, receiver);
            },

            has(target, prop) {
                if ('bc' in target.effects) {
                    const value = target.effects.bc[prop] !== undefined
                        ? target.effects.bc[prop]
                        : target.effects.bc.map?.[prop];

                    if (value !== undefined) {
                        return true;
                    }
                }

                return Reflect.has(target, prop);
            }
        });

        component.magewire ??= {};
        component.magewire.bc = { checksum, proxy };

        return proxy;
    };

    <?php /* Async public API: awaits Magewire readiness so the returned proxy is safe to hand to deprecated hook listeners. */ ?>
    const magewireMakeComponentBackwardsCompatible = async function(component) {
        await magewireBcReady;

        return _magewireMakeComponentBackwardsCompatibleSync(component);
    };
</script>
<?php $script->end() ?>
